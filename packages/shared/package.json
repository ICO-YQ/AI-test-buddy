{
  "name": "@huanbuddy/shared",
  "version": "1.0.0",
  "private": true,
  "description": "huanbuddy 前后端共享层：枚举、实体类型、API DTO、错误码、契约常量（零运行时依赖）",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./enums": "./src/enums.ts",
    "./types": "./src/types.ts",
    "./api": "./src/api.ts",
    "./errors": "./src/errors.ts",
    "./constants": "./src/constants.ts"
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
