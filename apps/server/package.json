{
  "name": "@huanbuddy/server",
  "version": "1.0.0",
  "private": true,
  "description": "huanbuddy 后端：Fastify + SQLite（node:sqlite / better-sqlite3 适配）",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "reset:db": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@huanbuddy/shared": "workspace:*",
    "fastify": "^5.6.0",
    "nanoid": "^5.1.5",
    "pino": "^9.5.0",
    "zod": "^3.25.61"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "2.1.2"
  }
}
