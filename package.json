{
  "name": "huanbuddy",
  "version": "1.0.0",
  "private": true,
  "description": "huanbuddy —— 以 AI 成员为一等公民的团队协作工作台",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @huanbuddy/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @huanbuddy/server migrate",
    "seed": "pnpm --filter @huanbuddy/server seed",
    "reset:db": "pnpm --filter @huanbuddy/server reset:db"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
